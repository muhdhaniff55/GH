name: Download to Release

on:
  workflow_dispatch:
    inputs:
      url:
        description: 'File or video URL'
        required: true
        type: string
      method:
        description: 'Download method'
        required: true
        default: 'auto'
        type: choice
        options:
          - auto
          - curl
          - yt-dlp
      referer:
        description: 'Referer header (optional)'
        required: false
        default: ''
        type: string
      max_size_gb:
        description: 'Max file size in GB'
        required: false
        default: '10'
        type: string
      tag:
        description: 'Release tag (optional, defaults to run ID)'
        required: false
        default: ''
        type: string

permissions:
  contents: write

jobs:
  mirror:
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Install tools
        run: |
          sudo apt-get update -y
          sudo apt-get install -y --no-install-recommends curl jq
          python3 -m pip install --quiet --user yt-dlp
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      - name: Download
        id: download
        env:
          INPUT_URL: ${{ github.event.inputs.url }}
          METHOD: ${{ github.event.inputs.method }}
          REFERER: ${{ github.event.inputs.referer }}
          MAX_GB: ${{ github.event.inputs.max_size_gb }}
        run: |
          set -uo pipefail

          case "$INPUT_URL" in
            http://*|https://*) ;;
            *) echo "::error::URL must start with http:// or https://"; exit 1 ;;
          esac

          DL_DIR="$RUNNER_TEMP/dl"
          rm -rf "$DL_DIR"; mkdir -p "$DL_DIR"
          MAX_BYTES=$(( ${MAX_GB:-10} * 1024 * 1024 * 1024 ))

          UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36'
          CURL_ARGS=(--fail --location --retry 3 --retry-delay 5 --user-agent "$UA"
                     --max-filesize "$MAX_BYTES")
          [ -n "$REFERER" ] && CURL_ARGS+=(--referer "$REFERER")

          download_curl() {
            echo "==> curl"
            HEADERS=$(curl "${CURL_ARGS[@]}" -sI "$INPUT_URL" || true)
            CTYPE=$(printf '%s' "$HEADERS" | grep -i '^content-type:' | tail -1 | tr -d '\r' | cut -d' ' -f2-)
            echo "Content-Type: ${CTYPE:-unknown}"
            case "${CTYPE,,}" in
              text/html*)
                if ! printf '%s' "$HEADERS" | grep -qi '^content-disposition:'; then
                  echo "This looks like a web page, not a file."
                  return 2
                fi ;;
            esac
            ( cd "$DL_DIR" && curl "${CURL_ARGS[@]}" --remote-name --remote-header-name \
                --progress-bar "$INPUT_URL" )
          }

          download_ytdlp() {
            echo "==> yt-dlp"
            yt-dlp --no-playlist --no-progress --restrict-filenames \
              --max-filesize "${MAX_GB:-10}G" ${REFERER:+--referer "$REFERER"} \
              -o "$DL_DIR/%(title).150B.%(ext)s" "$INPUT_URL"
          }

          case "$METHOD" in
            curl)    download_curl; STATUS=$? ;;
            yt-dlp)  download_ytdlp; STATUS=$? ;;
            *)       download_curl; STATUS=$?
                     if [ $STATUS -ne 0 ]; then
                       echo "curl didn't work (exit $STATUS), trying yt-dlp..."
                       rm -rf "$DL_DIR"; mkdir -p "$DL_DIR"
                       download_ytdlp; STATUS=$?
                     fi ;;
          esac

          if [ $STATUS -ne 0 ]; then
            echo "::error::Download failed (exit $STATUS). Check the URL, the Referer, or whether the host needs a login/ticket."
            exit 1
          fi

          FILE=$(find "$DL_DIR" -maxdepth 1 -type f ! -name '*.part' ! -name '*.ytdl' \
                   -printf '%s\t%p\n' | sort -rn | head -1 | cut -f2-)
          if [ -z "$FILE" ] || [ ! -s "$FILE" ]; then
            echo "::error::No (or empty) file was downloaded."
            exit 1
          fi

          if [ "$(stat -c%s "$FILE")" -lt 2048 ] && head -c 512 "$FILE" | grep -qiE '<html|<!doctype'; then
            echo "::error::Downloaded file is an HTML page, not the real file. The link probably needs a landing-page step or login."
            exit 1
          fi

          echo "path=$FILE" >> "$GITHUB_OUTPUT"
          echo "name=$(basename "$FILE")" >> "$GITHUB_OUTPUT"
          echo "size=$(stat -c%s "$FILE")" >> "$GITHUB_OUTPUT"
          echo "Downloaded: $(basename "$FILE") ($(du -h "$FILE" | cut -f1))"

      - name: Set release tag
        id: release
        run: |
          TAG="${{ github.event.inputs.tag }}"
          echo "tag=${TAG:-${{ github.run_id }}}" >> "$GITHUB_OUTPUT"

      - name: Upload to Release
        uses: softprops/action-gh-release@v1
        with:
          files: ${{ steps.download.outputs.path }}
          name: ${{ steps.download.outputs.name }}
          tag_name: ${{ steps.release.outputs.tag }}
          body: |
            Source: ${{ github.event.inputs.url }}

      - name: Summary
        if: success()
        env:
          NAME: ${{ steps.download.outputs.name }}
          SIZE: ${{ steps.download.outputs.size }}
          TAG: ${{ steps.release.outputs.tag }}
        run: |
          {
            echo "### Done"
            echo ""
            echo "- **File:** \`$NAME\`"
            echo "- **Size:** $(numfmt --to=iec "$SIZE")"
            echo "- **Tag:** \`$TAG\`"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Clean up
        if: always()
        run: rm -rf "$RUNNER_TEMP/dl"
        
